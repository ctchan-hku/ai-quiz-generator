# --- Required ---
OPENAI_API_KEY=<your-key>
MONGODB_URI=mongodb://<user>:<pass>@gi20db:27017/getting_interested?authSource=admin&replicaSet=rs0
ACCESS_TOKEN_SECRET=<same value as GEAR backend in this environment>
ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app,https://gear-cms.cetl.hku.hk

# --- Recommended ---
OPENAI_BASE_URL=https://api.openai-hk.com/v1
AVAILABLE_MODELS=[{"id":"gemini-3-flash","label":"Gemini 3 Flash"}]
APP_ENV=prod
ENABLE_DEBUG_CHAT_COMPLETION=false
LOG_FULL_LLM_PROMPT=false
DATA_DIR=/app/data/runtime

# --- Optional (defaults usually fine) ---
# MONGODB_DB_NAME=getting_interested
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# HF_TOKEN=