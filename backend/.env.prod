# Production Environment Config
# Runtime defaults are defined in app/config.py.
# Shared infrastructure secrets are injected by the GEAR sidecar volume.

# Required (Manage via Infisical)
# OPENAI_API_KEY=
# HF_TOKEN=

# Inherited from GEAR (Do not duplicate in Infisical)
# ACCESS_TOKEN_SECRET
# MONGODB_CONNECTION_STRING
# DATABASE_NAME=