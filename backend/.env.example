# Copy to .env.dev or .env.staging and fill in values (both gitignored).
# Non-secret defaults → app/config.py | APP_ENV → docker-compose-local.yml env_file
#
# --- .env.dev (local GEAR + local Mongo) ---
# APP_ENV=dev
# OPENAI_API_KEY=
# ACCESS_TOKEN_SECRET=
# MONGODB_URI=mongodb://root:...@gi20db-dev:27017/?replicaSet=rs0&authSource=admin
# DATABASE_NAME=getting_interested
# HF_TOKEN=
#
# --- .env.staging (remote GEAR + remote Mongo; omit ACCESS_TOKEN_SECRET) ---
# APP_ENV=staging
# OPENAI_API_KEY=
# MONGODB_URI=
# DATABASE_NAME=
# HF_TOKEN=
#
# Dev:     docker compose -f docker-compose-local.yml up
# Staging: ENV_FILE=.env.staging docker compose -f docker-compose-local.yml up
