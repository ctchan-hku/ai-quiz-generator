OPENAI_API_KEY=your_openai_api_key_here

OPENAI_BASE_URL=https://api.poe.com/v1

# Optional; default 120. Seconds per chat-completion HTTP request.
OPENAI_HTTP_TIMEOUT_SECONDS=120

# Optional; longer read timeout for huge completions (v2 answer step), e.g. OPENAI_HTTP_READ_TIMEOUT_SECONDS=600

ALLOWED_ORIGINS=*

AVAILABLE_MODELS='[{"id":"gemini-3-flash","label":"Gemini 3 Flash"},{"id":"gemini-3.1-pro","label":"Gemini 3.1 Pro"},{"id":"claude-sonnet-4.6","label":"Claude Sonnet 4.6"},{"id":"gpt-5.1-instant","label":"GPT-5.1 Instant"},{"id":"grok-4.20-multi-agent","label":"Grok 4.20 (multi-agent)"},{"id":"deepseek-v4-pro-e","label":"DeepSeek V4 Pro-E"}]'

# Cron: python cron/fetch_poe_models_pricing.py - optional POE_MODELS_PRICING_PATH, POE_MODELS_JSON_URL

ENABLE_DEBUG_CHAT_COMPLETION=false

# Verbose HTTP logs from the OpenAI client (retry reasons: status codes, timeouts).
LOG_OPENAI_HTTP_VERBOSE=false

# Log the full system and user prompts (and assistant replies) to the console.
LOG_FULL_LLM_PROMPT=true

# Signs workspace session JWTs (Bearer token). Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-secret

# Optional; default 7. Workspace session lifetime in days.
# SESSION_TTL_DAYS=7

# --- MongoDB (optional) ---
# Same URI the backend and MongoDB Compass use. Unset or leave empty to skip MongoDB.
# Verify connectivity: curl -s http://localhost:8080/db/health - explore data with mongosh or Compass.
MONGODB_URI=mongodb://localhost:27017

# Database name the app uses when MONGODB_URI is set.
MONGODB_DB_NAME=getting_interested

# --- Hugging Face (optional) ---
# Read token from https://huggingface.co/settings/tokens - avoids unauthenticated Hub rate limits.
# HF_TOKEN=hf_your_token_here

# --- LangChain / LangSmith (optional) ---
# Enable tracing to LangSmith (free Developer tier: 5k traces/month).
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=ai-test-generator
