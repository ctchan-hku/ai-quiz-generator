# Copy to .env.dev or .env.staging and fill in values (both gitignored).
# Non-secret defaults → app/config.py | APP_ENV=dev → docker-compose-dev.yml
#
# --- .env.dev (local GEAR + local Mongo) ---
# OPENAI_API_KEY=
# ACCESS_TOKEN_SECRET=
# MONGODB_URI=mongodb://root:...@gi20db-dev:27017/?replicaSet=rs0&authSource=admin
# HF_TOKEN=
#
# --- .env.staging (remote GEAR + remote Mongo; omit ACCESS_TOKEN_SECRET) ---
# OPENAI_API_KEY=
# MONGODB_URI=
# HF_TOKEN=
#
# Dev:     docker compose -f docker-compose-dev.yml up
# Staging: ENV_FILE=.env.staging docker compose -f docker-compose-dev.yml up
