# Copy to .env.dev or .env.staging (both gitignored). Vite loads .env.<mode>.
#
# --- .env.dev ---
# VITE_APP_API_PROXY_TARGET=http://127.0.0.1:8080
# VITE_GEAR_API_PROXY_TARGET=http://127.0.0.1:4000
# VITE_WORKSPACE_ENABLED=true
#
# --- .env.staging ---
# VITE_APP_API_PROXY_TARGET=http://127.0.0.1:8080
# VITE_GEAR_API_PROXY_TARGET=https://test-gear-cms.cetl.hku.hk
# VITE_WORKSPACE_ENABLED=true
#
# Dev:     npm run dev
# Staging: npm run staging
