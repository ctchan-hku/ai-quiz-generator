# Absolute API origin (e.g. https://your-app.up.railway.app — no :port; Railway serves HTTPS on 443).
#
# Local dev:
#   npm run dev / dev:local — leave unset; Vite proxies /api → http://127.0.0.1:8080 (run the backend locally).
#   npm run dev:remote — uses `.env.remote` (team Railway dev URL); set ALLOWED_ORIGINS on Railway to include http://localhost:5173.
# VITE_API_BASE_URL=

# CMS API origin for login/logout (gi-2.0-backend). Local dev: leave unset to use Vite proxy /cms-api → :4000.
# VITE_CMS_API_BASE_URL=

# Models are loaded from GET /api/models (see AVAILABLE_MODELS on the backend).
